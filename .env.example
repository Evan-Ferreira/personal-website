# Supabase (existing)
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Admin photo portal (/admin)
# Passcode you type on the login screen.
ADMIN_PASSCODE=
# Random secret used to sign the admin session cookie (e.g. `openssl rand -hex 32`).
ADMIN_COOKIE_SECRET=
# Fine-grained GitHub PAT with Contents: R/W + Pull requests: R/W on the repo below.
GITHUB_TOKEN=
GITHUB_REPO=Evan-Ferreira/personal-website-3.0
GITHUB_DEFAULT_BRANCH=main
